<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.najdev.scoreboard.homescreen.HomeFragment"
        android:label="Home" >
        <action
            android:id="@+id/action_homeFragment_to_scoreboardFragment"
            app:destination="@id/scoreboardFragment" />
        <action
            android:id="@+id/action_homeFragment_to_timerFragment"
            app:destination="@id/timerFragment" />
    </fragment>
    <fragment
        android:id="@+id/scoreboardFragment"
        android:name="com.najdev.scoreboard.scoreboardscreen.ScoreboardFragment"
        android:label="Scoreboard" />
    <fragment
        android:id="@+id/timerFragment"
        android:name="com.najdev.scoreboard.timerscreen.TimerFragment"
        android:label="Timer" />

</navigation>